diff --git a/src/runtime/asm_amd64.s b/src/runtime/asm_amd64.s
index 559fe25a..ab07ddb0 100644
--- a/src/runtime/asm_amd64.s
+++ b/src/runtime/asm_amd64.s
@@ -33,8 +33,12 @@ TEXT _rt0_amd64_lib(SB),NOSPLIT|NOFRAME,$0
 	// Transition from C ABI to Go ABI.
 	PUSH_REGS_HOST_TO_ABI0()
 
-	MOVQ	DI, _rt0_amd64_lib_argc<>(SB)
-	MOVQ	SI, _rt0_amd64_lib_argv<>(SB)
+	// miniBox: musl calls a constructor with no arguments, so DI and SI
+	// are whatever was there. Hand the runtime a fixed argv of one name,
+	// an empty environment and an auxv giving only the page size.
+	MOVQ	$1, _rt0_amd64_lib_argc<>(SB)
+	LEAQ	mbargv<>(SB), AX
+	MOVQ	AX, _rt0_amd64_lib_argv<>(SB)
 
 #ifdef GOOS_windows
 	// Set up a dummy TLS value on Windows so that the autogenerated
@@ -61,6 +65,17 @@ GLOBL _rt0_amd64_lib_argc<>(SB),NOPTR, $8
 DATA _rt0_amd64_lib_argv<>(SB)/8, $0
 GLOBL _rt0_amd64_lib_argv<>(SB),NOPTR, $8
 
+DATA mbname<>+0(SB)/8, $"minibox\x00"
+GLOBL mbname<>(SB), RODATA, $8
+DATA mbargv<>+0(SB)/8, $mbname<>(SB)	// argv[0]
+DATA mbargv<>+8(SB)/8, $0	// end of argv
+DATA mbargv<>+16(SB)/8, $0	// end of envp
+DATA mbargv<>+24(SB)/8, $6	// AT_PAGESZ
+DATA mbargv<>+32(SB)/8, $4096
+DATA mbargv<>+40(SB)/8, $0	// AT_NULL
+DATA mbargv<>+48(SB)/8, $0
+GLOBL mbargv<>(SB), NOPTR, $56
+
 #ifdef GOAMD64_v2
 DATA bad_cpu_msg<>+0x00(SB)/84, $"This program can only be run on AMD64 processors with v2 microarchitecture support.\n"
 #endif
@@ -1223,6 +1238,8 @@ TEXT runtime·stackcheck(SB), NOSPLIT|NOFRAME, $0-0
 
 // func cputicks() int64
 TEXT runtime·cputicks(SB),NOSPLIT,$0-0
+	// miniBox: the sandbox's clock, which is the same in every run.
+	JMP	runtime·nanotime1(SB)
 	CMPB	internal∕cpu·X86+const_offsetX86HasRDTSCP(SB), $1
 	JNE	fences
 	// Instruction stream serializing RDTSCP is supported.
