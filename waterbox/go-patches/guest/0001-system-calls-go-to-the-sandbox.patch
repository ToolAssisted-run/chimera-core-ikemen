diff --git a/src/runtime/sys_minibox_linux.go b/src/runtime/sys_minibox_linux.go
new file mode 100644
index 00000000..564c3b30
--- /dev/null
+++ b/src/runtime/sys_minibox_linux.go
@@ -0,0 +1,10 @@
+// miniBox: the system calls of the runtime and of package syscall go to the
+// sandbox (sys_minibox_linux_amd64.s).
+
+package runtime
+
+// mbsyscall is called from the assembly of package syscall and of
+// internal/runtime/syscall/linux as well.
+//
+//go:linkname mbsyscall
+func mbsyscall()
diff --git a/src/runtime/sys_minibox_linux_amd64.s b/src/runtime/sys_minibox_linux_amd64.s
new file mode 100644
index 00000000..b657483a
--- /dev/null
+++ b/src/runtime/sys_minibox_linux_amd64.s
@@ -0,0 +1,63 @@
+// miniBox: every system call of the runtime and of package syscall comes here
+// instead of executing SYSCALL, which would go to the real kernel.
+
+#include "textflag.h"
+
+// mbsyscall takes a system call the way SYSCALL does - the number in AX, the
+// arguments in DI, SI, DX, R10, R8 and R9, the answer in AX, every register
+// but CX and R11 kept - and makes it the way the sandbox takes one: a call to
+// its trampoline at 0x35f00000080, with the fourth argument in CX. The
+// trampoline keeps none of the other registers (it may switch to another
+// thread before it returns, and it zeroes the scratch ones), so they are
+// saved here.
+//
+// A few calls the sandbox does not provide are answered here instead:
+//   sigaltstack (131): there are no signals; any old stack is "disabled".
+//   mincore (27), prlimit64 (302): ENOSYS. The runtime and package syscall
+//   take that answer and run on.
+TEXT runtime·mbsyscall(SB),NOSPLIT|NOFRAME,$0
+	PUSHQ	BX
+	PUSHQ	DX
+	PUSHQ	SI
+	PUSHQ	DI
+	PUSHQ	R8
+	PUSHQ	R9
+	PUSHQ	R10
+	PUSHQ	R12
+	PUSHQ	R13
+	PUSHQ	R14
+	PUSHQ	R15
+	CMPQ	AX, $131
+	JEQ	altstack
+	CMPQ	AX, $27
+	JEQ	nosys
+	CMPQ	AX, $302
+	JEQ	nosys
+	MOVQ	R10, CX
+	MOVQ	$0x35f00000080, R10
+	CALL	R10
+done:
+	POPQ	R15
+	POPQ	R14
+	POPQ	R13
+	POPQ	R12
+	POPQ	R10
+	POPQ	R9
+	POPQ	R8
+	POPQ	DI
+	POPQ	SI
+	POPQ	DX
+	POPQ	BX
+	RET
+altstack:
+	TESTQ	SI, SI
+	JEQ	altok
+	MOVQ	$0, 0(SI)	// ss_sp
+	MOVL	$2, 8(SI)	// ss_flags = SS_DISABLE
+	MOVQ	$0, 16(SI)	// ss_size
+altok:
+	XORL	AX, AX
+	JMP	done
+nosys:
+	MOVQ	$-38, AX	// -ENOSYS
+	JMP	done
