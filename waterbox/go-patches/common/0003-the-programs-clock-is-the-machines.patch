index 00000000..d66d4f7a
--- /dev/null
+++ b/src/time/chimera_clock.go
@@ -0,0 +1,15 @@
+// Chimera: the time a program reads with Now is the machine's.
+
+package time
+
+import _ "unsafe" // for go:linkname
+
+// chimeraClock is the machine's time, in nanoseconds since 1970 UTC. The
+// core sets it, and moves it with the frames; until then it is the first of
+// January 2000. Now reads it in both of the core's builds, so a game's
+// clock - and a random seed taken from it - is part of the machine, the same
+// in every run. The runtime's own clock, which timers, sleeps and the
+// scheduler use, is not this one.
+var chimeraClock int64 = 946684800 * 1000000000
+
+//go:linkname chimeraClock
