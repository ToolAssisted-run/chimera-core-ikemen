+// Chimera: a file system the program brings itself. When it is set, every
+// call made through Syscall and Syscall6 is offered to it first; it answers
+// the calls it takes (handled) and leaves the others to the kernel. The core
+// sets it from package main, through a linkname.
+var chimeraFS func(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno, handled bool)
+
+//go:linkname chimeraFS
+
 //go:uintptrkeepalive
 //go:nosplit
 //go:linkname Syscall
 func Syscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
+	if fs := chimeraFS; fs != nil {
+		var handled bool
+		if r1, r2, err, handled = fs(trap, a1, a2, a3, 0, 0, 0); handled {
+			return
+		}
+	}
 	runtime_entersyscall()
 	// N.B. Calling RawSyscall here is unsafe with atomic coverage
 	// instrumentation and race mode.
@@ -93,6 +107,12 @@ func Syscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
 //go:nosplit
 //go:linkname Syscall6
 func Syscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
+	if fs := chimeraFS; fs != nil {
+		var handled bool
+		if r1, r2, err, handled = fs(trap, a1, a2, a3, a4, a5, a6); handled {
+			return
+		}
+	}
 	runtime_entersyscall()
 	r1, r2, err = RawSyscall6(trap, a1, a2, a3, a4, a5, a6)
 	runtime_exitsyscall()
